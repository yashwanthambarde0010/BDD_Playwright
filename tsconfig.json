{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "@playwright/test", "@cucumber/cucumber"]
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "reports"
  ]
}
